diff -up piper-phonemize-2023.11.14/CMakeLists.txt.1~ piper-phonemize-2023.11.14/CMakeLists.txt
--- piper-phonemize-2023.11.14/CMakeLists.txt.1~	2023-11-14 18:54:34.000000000 +0100
+++ piper-phonemize-2023.11.14/CMakeLists.txt	2025-11-16 19:30:00.813868181 +0100
@@ -36,6 +36,10 @@ set_target_properties(piper_phonemize PR
 
 # ---- onnxruntime ---
 
+option(SYSTEM_ONNXRUNTIME "Use system ONNX Runtime" ON)
+if(SYSTEM_ONNXRUNTIME)
+    include_directories(/usr/include/onnxruntime)
+else()
 # Look for onnxruntime files in <root>/lib
 if(NOT DEFINED ONNXRUNTIME_DIR)
     if(NOT DEFINED ONNXRUNTIME_VERSION)
@@ -94,9 +98,12 @@ if(NOT DEFINED ONNXRUNTIME_DIR)
         file(ARCHIVE_EXTRACT INPUT "download/${ONNXRUNTIME_FILENAME}" DESTINATION "${CMAKE_CURRENT_LIST_DIR}/lib")
     endif()
 endif()
+endif()
 
 # ---- espeak-ng ---
 
+option(SYSTEM_ESPEAK_NG "Use system espeak-ng" ON)
+if(NOT SYSTEM_ESPEAK_NG)
 if(NOT DEFINED ESPEAK_NG_DIR)
     set(ESPEAK_NG_DIR "${CMAKE_CURRENT_BINARY_DIR}/ei")
 
@@ -119,6 +126,7 @@ if(NOT DEFINED ESPEAK_NG_DIR)
     )
     add_dependencies(piper_phonemize espeak_ng_external)
 endif()
+endif()
 
 
 # ---- Declare library ----
@@ -222,10 +230,13 @@ install(
     TYPE DATA)
 
 # Dependencies
+if(NOT SYSTEM_ESPEAK_NG)
 install(
     DIRECTORY ${ESPEAK_NG_DIR}/
     DESTINATION ${CMAKE_INSTALL_PREFIX})
+endif()
 
+if(NOT SYSTEM_ONNXRUNTIME)
 install(
     DIRECTORY ${ONNXRUNTIME_DIR}/include/
     DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
@@ -233,3 +244,4 @@ install(
 install(
     DIRECTORY ${ONNXRUNTIME_DIR}/lib/
     DESTINATION ${CMAKE_INSTALL_LIBDIR})
+endif()
